<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same as backup_rules.xml, for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="backend.xml" />
        <include domain="sharedpref" path="ui.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="backend.xml" />
        <include domain="sharedpref" path="ui.xml" />
    </device-transfer>
</data-extraction-rules>
