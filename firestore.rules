rules_version = '2';

// Security rules for the Van Tracker Firestore database.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(profilePath()).data; }
    function active() { return signedIn() && exists(profilePath()) && me().active == true && me().role != 'PENDING'; }
    function isAdmin() { return active() && me().isAdmin == true; }
    function isManager() { return active() && (me().role in ['GM', 'OM', 'ADMIN'] || me().isAdmin == true); }
    function isDriver() { return active() && me().role == 'DRIVER'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function autoApproveRuns() {
      return get(/databases/$(database)/documents/config/settings).data.get('autoApproveScheduled', true) != false;
    }

    // First account may claim the administrator role exactly once.
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid && (
        (request.resource.data.role == 'PENDING' && request.resource.data.isAdmin == false)
        || (request.resource.data.isAdmin == true
            && !exists(/databases/$(database)/documents/meta/bootstrap)
            && getAfter(/databases/$(database)/documents/meta/bootstrap).data.adminUid == request.auth.uid)
      );
      allow update: if isAdmin()
        || (uid == request.auth.uid && !changed().hasAny(['role', 'isAdmin', 'active']));
      allow delete: if isAdmin();
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Fleet, managed by administrators.
    match /vehicles/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Live position per vehicle, written by the driver on the ride.
    match /live/{vehicleId} {
      allow read: if active();
      allow write: if isDriver() || isAdmin();
    }

    // Old single-van live document (before multi-vehicle support).
    match /vehicle/{doc} {
      allow read: if active();
      allow write: if isDriver() || isAdmin();
    }

    match /requests/{id} {
      allow read: if active();
      // Normal requests start PENDING; seats on pre-approved scheduled runs may be confirmed directly.
      allow create: if active() && request.resource.data.requesterUid == request.auth.uid
        && (request.resource.data.status == 'PENDING'
            || (request.resource.data.status == 'APPROVED'
                && request.resource.data.joinTarget.matches('sched:.*') && autoApproveRuns()));
      allow update: if isManager() || isDriver()
        || (active() && resource.data.requesterUid == request.auth.uid && request.resource.data.status == 'CANCELLED');
      allow delete: if isAdmin();
    }

    match /trips/{id} {
      allow read: if active();
      // Anyone booking a seat may open today's run of a schedule (ids "sched_<schedule>_<day>").
      allow create: if isManager() || isDriver()
        || (active() && id.matches('sched_.*') && request.resource.data.type == 'SCHEDULED'
            && request.resource.data.status == 'READY');
      // HODs may only detach their own stop from a trip that has not started (cancel request).
      allow update: if isManager() || isDriver()
        || (active() && resource.data.status in ['READY', 'ASSIGNED'] && changed().hasOnly(['requestIds', 'stops', 'passengers', 'status']))
        || (active() && id.matches('sched_.*') && resource.data.status in ['READY', 'ASSIGNED']
            && changed().hasOnly(['requestIds', 'departments', 'stops', 'passengers']));
      allow delete: if isAdmin();

      match /track/{chunk} {
        allow read: if active();
        allow write: if isDriver();
      }
    }

    match /schedules/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /alerts/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }

    // Driver on/off duty history.
    match /dutyLogs/{id} {
      allow read: if active();
      allow create: if isDriver() && request.resource.data.driverUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Administrator actions from the web dashboard (append-only).
    match /audit/{id} {
      allow read: if isManager();
      allow create: if isAdmin() && request.resource.data.byUid == request.auth.uid;
    }

    // Monthly email report: run history and heartbeat, written by the report script's user.
    match /reportRuns/{id} {
      allow read: if isManager();
      allow create, update: if active();
      allow delete: if isAdmin();
    }

    match /fuelLogs/{id} {
      allow read: if active();
      allow create: if isDriver() || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
