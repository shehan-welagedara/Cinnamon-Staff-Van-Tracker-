rules_version = '2';

// Security rules for the Van Tracker Firestore database.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(profilePath()).data; }
    function active() { return signedIn() && exists(profilePath()) && me().active == true && me().role != 'PENDING'; }
    function isAdmin() { return active() && me().isAdmin == true; }
    function isManager() { return active() && (me().role in ['GM', 'OM', 'ADMIN'] || me().isAdmin == true); }
    function isDriver() { return active() && me().role == 'DRIVER'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // First account may claim the administrator role exactly once.
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid && (
        (request.resource.data.role == 'PENDING' && request.resource.data.isAdmin == false)
        || (request.resource.data.isAdmin == true
            && !exists(/databases/$(database)/documents/meta/bootstrap)
            && getAfter(/databases/$(database)/documents/meta/bootstrap).data.adminUid == request.auth.uid)
      );
      allow update: if isAdmin()
        || (uid == request.auth.uid && !changed().hasAny(['role', 'isAdmin', 'active']));
      allow delete: if isAdmin();
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Fleet, managed by administrators.
    match /vehicles/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Live position per vehicle, written by the driver on the ride.
    match /live/{vehicleId} {
      allow read: if active();
      allow write: if isDriver() || isAdmin();
    }

    // Old single-van live document (before multi-vehicle support).
    match /vehicle/{doc} {
      allow read: if active();
      allow write: if isDriver() || isAdmin();
    }

    match /requests/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update: if isManager() || isDriver()
        || (active() && resource.data.requesterUid == request.auth.uid && request.resource.data.status == 'CANCELLED');
      allow delete: if isAdmin();
    }

    match /trips/{id} {
      allow read: if active();
      allow create: if isManager() || isDriver();
      // HODs may only detach their own stop from a trip that has not started (cancel request).
      allow update: if isManager() || isDriver()
        || (active() && resource.data.status in ['READY', 'ASSIGNED'] && changed().hasOnly(['requestIds', 'stops', 'passengers', 'status']));
      allow delete: if isAdmin();

      match /track/{chunk} {
        allow read: if active();
        allow write: if isDriver();
      }
    }

    match /schedules/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /alerts/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }

    // Driver on/off duty history.
    match /dutyLogs/{id} {
      allow read: if active();
      allow create: if isDriver() && request.resource.data.driverUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /fuelLogs/{id} {
      allow read: if active();
      allow create: if isDriver() || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
